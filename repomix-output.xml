<file path="substation.prisma">
model SubStation {
  id          String  @id @default(uuid())
  name        String
  capacityKw  Int?
  allocatedKw Int?
  //   zonalManagerId      String            
  //   zonalManager        ZoneManager       @relation(fields: [zonalManagerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  subStationManagerId String?            @unique
  subStationManager   SubStationManager? @relation(fields: [subStationManagerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  zoneId              String
  zone                Zone               @relation(fields: [zoneId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  feeders             Feeder[]
  areas               Area[]
  houses              House[]
  shcedules           Schedule[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([zoneId])
  //   @@index([zonalManagerId])
  @@map("substations")
}
</file>

<file path="substationManager.prisma">
model SubStationManager {
  id            String      @id @default(uuid())
  name          String
  email         String      @unique
  address       String
  contactNumber String?
  employeeId    String
  zoneId        String
  zone          Zone        @relation(fields: [zoneId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subStation    SubStation?
  schedules     Schedule[]
  isDeleted     Boolean     @default(false)
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  // areaId
  userId        String      @unique
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([zoneId])
  @@index([email], name: "idx_substationManager_email")
  @@map("substationManager")
}
</file>

<file path="technicianProfile.prisma">
model TechnicianProfile {
  id                 String                       @id @default(uuid())
  name               String
  email              String                       @unique
  address            String
  contactNumber      String?
  expertise          String
  experienceYear     Int
  verificationStatus TechnicianVerificationStatus @default(PENDING)
  rejectionReason    String?
  reviewedBy         String?
  reviewedAt         DateTime?
  resumeUrl          String?
  resumePublicId     String?
  isDeleted          Boolean                      @default(false)
  deletedAt          DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  // areaId
  isAvailable        TechnicianAvailabilityStatus @default(AVAILABLE)
  userId             String                       @unique
  user               User                         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([email], name: "idx_technician_email")
  @@index([isDeleted], name: "idx_technician_isDeleted")
  @@map("technicianProfiles")
}
</file>

<file path="token.prisma">
model Token {
  id             String      @id @default(uuid())
  tokenNo        String
  tokenSeqNo     Int
  meterNo        String
  meterType      MeterType   @default(OFFLINE_PREPAID)
  rechargeAmount Decimal
  tokenStatus    TokenStatus @default(UNUSED)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Reserved for Future Expansion:
  // vendingAmount Decimal?
  // meterRent     Decimal?
  // demandCharge  Decimal?
  // vat           Decimal?
  // rebate        Decimal?

  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  payment    Payment?

  @@index([customerId])
  @@map("tokens")
}
</file>

<file path="user.prisma">
model User {
  id                 String      @id @default(uuid())
  name               String
  email              String      @unique
  passwordHash       String
  role               Role?       @default(CUSTOMER)
  status             UserStatus? @default(ACTIVE)
  nid                String?     @unique
  dob                String?
  isDeleted          Boolean?    @default(false)
  deletedAt          DateTime?
  emailVerified      Boolean?    @default(false)
  needPasswordChange Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  customerProfile   CustomerProfile?
  technicianProfile TechnicianProfile?
  zoneManager       ZoneManager?
  subStationManager SubStationManager?

  @@map("users")
}
</file>

<file path="zone.prisma">
model Zone {
  id                 String              @id @default(uuid())
  name               String
  zonalManagerId     String?             @unique
  zonalManager       ZoneManager?        @relation(fields: [zonalManagerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subStations        SubStation[]
  subStationManagers SubStationManager[]
  feeders            Feeder[]
  areas              Area[]
  houses             House[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("zones")
}
</file>

