<file path="area.prisma">
model Area {
  id            String     @id @default(uuid())
  name          String
  // capacityKw String?
  // allocatedKw String?
  zoneId        String
  zone          Zone       @relation(fields: [zoneId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  substationId  String
  substation    SubStation @relation(fields: [substationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  feederId      String
  feeder        Feeder     @relation(fields: [feederId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  houses        House[]
  schedules     Schedule[]
  isPowerOut    Boolean    @default(false)
  scheduleStart DateTime?
  scheduleEnd   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([zoneId])
  @@index([substationId])
  @@index([feederId])
  @@map("areas")
}
</file>

<file path="customerProfile.prisma">
model CustomerProfile {
  id            String    @id @default(uuid())
  name          String
  email         String
  address       String?
  contactNumber String?
  meterNumber   String
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt // Standardized camelCase

  userId String  @unique
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tokens Token[]

  @@index([email], name: "idx_customer_email")
  @@index([isDeleted], name: "idx_customer_isDeleted")
  @@map("customers")
}
</file>

<file path="enums.prisma">
enum Role {
  CUSTOMER
  TECHNICIAN
  SUBSTATION_MANAGER
  ZONE_MANAGER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum TechnicianVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TechnicianAvailabilityStatus {
  OFF_DUTY
  AVAILABLE
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
}

enum MeterType {
  ONLINE_PREPAID
  ONLINE_POSTPAID
  OFFLINE_PREPAID
  OFFLINE_POSTPAID
}

enum TokenStatus {
  USED
  UNUSED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum ScheduleStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  UPCOMING
  ONGOING
  COMPLETED
}
</file>

<file path="feeder.prisma">
model Feeder {
  id           String     @id @default(uuid())
  name         String
  // capacityKw String?
  // allocatedKw String?
  zoneId       String
  zone         Zone       @relation(fields: [zoneId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  substationId String
  substation   SubStation @relation(fields: [substationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  areas        Area[]
  houses       House[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([zoneId])
  @@index([substationId])
  @@map("feeders")
}
</file>

<file path="house.prisma">
model House {
  id            String     @id @default(uuid())
  name          String
  zoneId        String
  zone          Zone       @relation(fields: [zoneId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  substationId  String
  substation    SubStation @relation(fields: [substationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  feederId      String
  feeder        Feeder     @relation(fields: [feederId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  areaId        String
  area          Area       @relation(fields: [areaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  isPowerOut    Boolean    @default(false)
  isScheduled   Boolean    @default(false)
  scheduleStart DateTime?
  scheduleEnd   DateTime?

  @@index([zoneId])
  @@index([substationId])
  @@index([feederId])
  @@index([areaId])
  @@map("houses")
}
</file>

<file path="payment.prisma">
model Payment {
  id                    String        @id @default(uuid())
  status                PaymentStatus @default(UNPAID)
  amount                Decimal
  currency              String        @default("BDT")
  paymentGateway        String        @default("bkash")
  merchantInvoiceNumber String        @unique
  bkashPaymentId        String?       @unique
  bkashTrxId            String?
  payerReference        String?
  paidAt                String?
  gatewayResponse       Json?
  refundTrxId           String?
  refundAmount          String?
  refundReason          String? // Fixed typo: refundReson -> refundReason
  refundAt              String?

  tokenId String @unique
  token   Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}
</file>

<file path="schedule.prisma">
model Schedule {
  id           String            @id @default(uuid())
  title        String?
  status       ScheduleStatus    @default(DRAFT)
  reason       String?
  startTime    DateTime
  endTime      DateTime
  isDeleted    Boolean           @default(false)
  deletedAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  areaId       String
  area         Area              @relation(fields: [areaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subStationId String
  subStation   SubStation        @relation(fields: [subStationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdById  String
  createdBy    SubStationManager @relation(fields: [createdById], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([areaId, startTime, endTime], name: "unique_schedule")
  @@index([subStationId])
  @@index([createdById])
  @@map("shcedules")
}
</file>

