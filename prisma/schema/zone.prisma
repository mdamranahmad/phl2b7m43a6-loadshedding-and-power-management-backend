model Zone {
  id                 String              @id @default(uuid())
  name               String
  zonalManagerId     String?             @unique
  zonalManager       ZoneManager?        @relation(fields: [zonalManagerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subStations        SubStation[]
  subStationManagers SubStationManager[]
  feeders            Feeder[]
  areas              Area[]
  houses             House[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("zones")
}
