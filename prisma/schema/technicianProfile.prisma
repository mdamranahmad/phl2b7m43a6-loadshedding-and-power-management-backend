model TechnicianProfile {
  id                 String                       @id @default(uuid())
  name               String
  email              String                       @unique
  address            String
  contactNumber      String?
  expertise          String
  experienceYear     Int
  verificationStatus TechnicianVerificationStatus @default(PENDING)
  rejectionReason    String?
  reviewedBy         String?
  reviewedAt         DateTime?
  resumeUrl          String?
  resumePublicId     String?
  isDeleted          Boolean                      @default(false)
  deletedAt          DateTime?
  createdAt          DateTime                     @default(now())
  updatedat          DateTime                     @updatedAt
  // areaId
  isAvailable        TechnicianAvailabilityStatus @default(AVAILABLE)
  userId             String                       @unique
  user               User                         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([email], name: "idx_technician_email")
  @@index([isDeleted], name: "idx_technician_isDeleted")
  @@map("technicianProfiles")
}
