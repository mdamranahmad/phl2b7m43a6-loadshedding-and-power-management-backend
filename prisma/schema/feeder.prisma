model Feeder {
  id           String     @id @default(uuid())
  name         String
  // capacityKw String?
  // allocatedKw String?
  zoneId       String
  zone         Zone       @relation(fields: [zoneId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  substationId String
  substation   SubStation @relation(fields: [substationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  areas        Area[]
  houses       House[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([zoneId])
  @@index([substationId])
  @@map("feeders")
}
