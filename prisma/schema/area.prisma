model Area {
  id            String         @id @default(uuid())
  name          String
  // capacityKw String?
  // allocatedKw String?
  zoneId        String
  zone          Zone           @relation(fields: [zoneId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  substationId  String
  substation    SubStation     @relation(fields: [substationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  feederId      String
  feeder        Feeder         @relation(fields: [feederId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  houses        House[]
  schedules     Schedule[]
  isPowerOut    Boolean        @default(false)
  scheduleStart DateTime?
  scheduleEnd   DateTime?
  outageReports OutageReport[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([zoneId])
  @@index([substationId])
  @@index([feederId])
  @@map("areas")
}
